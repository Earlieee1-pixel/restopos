APP_NAME=RestoPos
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database (MySQL) ─────────────────────────────────────────
# Gamiton ang MySQL — production-ready
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restopos
DB_USERNAME=root
DB_PASSWORD=

# Para sa production server, i-change ni:
# DB_HOST=your-db-host
# DB_USERNAME=your-db-user
# DB_PASSWORD=your-secure-password

# ─── Session & Cache ─────────────────────────────────────────
# I-file nalang para simple — pwede i-change sa production
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# ─── Sanctum / CORS ──────────────────────────────────────────
# I-set ang frontend URL para ma-allow ang CORS
SANCTUM_STATEFUL_DOMAINS=localhost:5173
FRONTEND_URL=http://localhost:5173
# Token expiry — 480 minutes = 8 hours (usa ka shift)
SANCTUM_TOKEN_EXPIRATION=480

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@restopos.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── POS Config ──────────────────────────────────────────────
# Mga settings para sa receipt ug currency
RESTAURANT_NAME="RestoPos"
CURRENCY=PHP
RECEIPT_HEADER="Thank you for your order!"

VITE_APP_NAME="${APP_NAME}"
